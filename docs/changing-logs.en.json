                        {
                            "type": "Features",
                            "desc": [
                                "Introduced a completely redesigned shopping experience.",
                                "Added complete English and Chinese support across the website.",
                                "Enhanced item pages with variations, image galleries, categories, origins, and shareable links.",
                                "Added more delivery and payment options, downloadable invoices, and receipt previews.",
                                "Improved sorting and filtering and kept selected choices while browsing."
                            ]
                        },
                        {
                            "type": "Improvements",
                            "desc": [
                                "Refreshed page layouts and navigation for a clearer, more consistent experience.",
                                "Improved cart and checkout checks, cleared the cart after successful orders, and made error messages clearer.",
                                "Improved the speed and responsiveness of item and order listings.",
                                "Improved the website's stability and reliability for everyday use."
                            ]
                        },
                        {
                            "type": "Other",
                            "desc": [
                                "v4 includes the completed features originally planned for the unreleased v3."
