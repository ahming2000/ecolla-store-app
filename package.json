{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "type-check": "composer wayfinder:generate && vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "check": "npm run type-check && npm run build",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6",
        "axios": "^1.18.1",
        "laravel-vite-plugin": "^3.1",
        "lodash": "^4.18.1",
        "pinia": "^4.0.2",
        "primeicons": "^8.0.0",
        "primevue": "^5.0.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-primeui": "^0.6.1",
        "vue": "^3.5.40",
        "vue-i18n": "^11.4.8"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@playwright/test": "^1.62.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.1",
        "vue-tsc": "^3.3.8"
    }
}
